{
  "$schema": "urn:pulse:schema:1-draft:case",
  "case_id": "pass",
  "name": "Typed flow, variables, if and bounded loop",
  "goal": "Reach every step and satisfy all required checkpoints",
  "parameters": {
    "product": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": false,
      "default": 2
    }
  },
  "profile_refs": ["fake-android"],
  "inputs": {
    "product": {
      "data_ref": "cart",
      "key": "product"
    }
  },
  "locators": {},
  "preconditions": [
    {
      "id": "page-ready",
      "required": true,
      "condition": {
        "operator": "exists",
        "target": {
          "locator_ref": "page"
        },
        "source": "native"
      }
    }
  ],
  "steps": [
    {
      "type": "action",
      "id": "type-search",
      "action": {
        "kind": "input",
        "target": {
          "locator_ref": "search"
        },
        "text": {
          "param_ref": "product"
        },
        "mode": "replace"
      }
    },
    {
      "type": "flow",
      "id": "fill-flow",
      "flow_ref": "fill-search",
      "arguments": {
        "query": {
          "param_ref": "product"
        }
      },
      "bind": {
        "label": "label"
      }
    },
    {
      "type": "action",
      "id": "use-return",
      "action": {
        "kind": "input",
        "target": {
          "locator_ref": "product"
        },
        "text": {
          "var_ref": "label"
        },
        "mode": "replace"
      }
    },
    {
      "type": "if",
      "id": "banner-branch",
      "condition": {
        "operator": "exists",
        "target": {
          "locator_ref": "banner"
        },
        "source": "native"
      },
      "then": [
        {
          "type": "action",
          "id": "tap-banner",
          "action": {
            "kind": "tap",
            "target": {
              "locator_ref": "banner"
            }
          }
        }
      ],
      "else": [
        {
          "type": "wait",
          "id": "wait-page",
          "condition": {
            "operator": "page_is",
            "target": {
              "locator_ref": "page"
            },
            "source": "native"
          }
        }
      ]
    },
    {
      "type": "loop",
      "id": "bounded",
      "max_iterations": 2,
      "condition": {
        "operator": "count_lt",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": 2
      },
      "steps": [
        {
          "type": "extract",
          "id": "iteration-label",
          "target": {
            "locator_ref": "product"
          },
          "source": "native",
          "attribute": "text",
          "as": "iteration_label"
        },
        {
          "type": "action",
          "id": "long-product",
          "action": {
            "kind": "long",
            "target": {
              "locator_ref": "product"
            },
            "duration_ms": 600
          }
        }
      ]
    },
    {
      "type": "action",
      "id": "swipe",
      "action": {
        "kind": "swipe",
        "start": {
          "x": 500,
          "y": 1500,
          "width": 1080,
          "height": 2400
        },
        "end": {
          "x": 500,
          "y": 800,
          "width": 1080,
          "height": 2400
        },
        "duration_ms": 500
      }
    },
    {
      "type": "action",
      "id": "back",
      "action": {
        "kind": "key",
        "key": "BACK"
      }
    },
    {
      "type": "check",
      "id": "confirm-step",
      "checkpoint": {
        "id": "confirm-checked",
        "required": true,
        "condition": {
          "operator": "checked",
          "target": {
            "locator_ref": "confirm"
          },
          "source": "native",
          "expected": true
        }
      }
    }
  ],
  "checks": [
    {
      "id": "product-name",
      "required": true,
      "condition": {
        "operator": "text_equals",
        "target": {
          "locator_ref": "product"
        },
        "source": "native",
        "expected": {
          "param_ref": "product"
        }
      }
    },
    {
      "id": "contains-text",
      "required": true,
      "condition": {
        "operator": "contains",
        "target": {
          "locator_ref": "product"
        },
        "source": "native",
        "expected": "Cof"
      }
    },
    {
      "id": "regex-text",
      "required": true,
      "condition": {
        "operator": "regex",
        "target": {
          "locator_ref": "product"
        },
        "source": "native",
        "expected": "^Coffee$"
      }
    },
    {
      "id": "count-eq",
      "required": true,
      "condition": {
        "operator": "count_eq",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": {
          "param_ref": "quantity"
        }
      }
    },
    {
      "id": "count-gt",
      "required": true,
      "condition": {
        "operator": "count_gt",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": 0
      }
    },
    {
      "id": "visible-search",
      "required": true,
      "condition": {
        "operator": "visible",
        "target": {
          "locator_ref": "search"
        },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "not-exists-banner",
      "required": true,
      "condition": {
        "operator": "not_exists",
        "target": {
          "locator_ref": "banner"
        },
        "source": "native",
        "scope": {
          "locator_ref": "page"
        },
        "observation_window_ms": 300,
        "poll_interval_ms": 100
      }
    },
    {
      "id": "page-final",
      "required": true,
      "condition": {
        "operator": "page_is",
        "target": {
          "locator_ref": "page"
        },
        "source": "native"
      }
    }
  ],
  "source": "hand-authored interpreter fixture"
}
