{
  "name": "@pulse/desktop",
  "productName": "Pulse",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse desktop client (Electron + React + TS)",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc -p tsconfig.json",
