{
  "$schema": "urn:pulse:schema:1-draft:case",
  "case_id": "operators",
  "name": "All checkpoint operators",
  "goal": "Keep fixed expectations independent of hypothetical observations",
  "parameters": {},
  "profile_refs": ["android-fixture"],
  "inputs": {},
  "locators": {},
  "preconditions": [],
  "steps": [
    {
      "type": "wait",
      "id": "ready",
      "condition": { "operator": "exists", "target": { "locator_ref": "page" }, "source": "native" }
    }
  ],
  "checks": [
    {
      "id": "exists",
      "required": true,
      "condition": {
        "operator": "exists",
        "target": { "locator_ref": "product" },
        "source": "native"
      }
    },
    {
      "id": "not_exists",
      "required": true,
      "condition": {
        "operator": "not_exists",
        "target": { "locator_ref": "banner" },
        "source": "native",
        "scope": { "locator_ref": "page" },
        "observation_window_ms": 1000,
        "poll_interval_ms": 500
      }
    },
    {
      "id": "visible",
      "required": true,
      "condition": {
        "operator": "visible",
        "target": { "locator_ref": "product" },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "enabled",
      "required": true,
      "condition": {
        "operator": "enabled",
        "target": { "locator_ref": "confirm" },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "checked",
      "required": true,
      "condition": {
        "operator": "checked",
        "target": { "locator_ref": "confirm" },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "text_equals",
      "required": true,
      "condition": {
        "operator": "text_equals",
        "target": { "locator_ref": "product" },
        "source": "native",
        "expected": "Coffee"
      }
    },
    {
      "id": "contains",
      "required": true,
      "condition": {
        "operator": "contains",
        "target": { "locator_ref": "product" },
        "source": "native",
        "expected": "Coff"
      }
    },
    {
      "id": "regex",
      "required": true,
      "condition": {
        "operator": "regex",
        "target": { "locator_ref": "product" },
        "source": "native",
        "expected": "^Coffee$"
      }
    },
    {
      "id": "count_eq",
      "required": true,
      "condition": {
        "operator": "count_eq",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": 1
      }
    },
    {
      "id": "count_gt",
      "required": true,
      "condition": {
        "operator": "count_gt",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": 0
      }
    },
    {
      "id": "count_lt",
      "required": true,
      "condition": {
        "operator": "count_lt",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": 2
      }
    },
    {
      "id": "number_cmp",
      "required": true,
      "condition": {
        "operator": "number_cmp",
        "target": { "locator_ref": "product" },
        "source": "native",
        "comparison": "eq",
        "expected": { "data_ref": "cart", "key": "total" },
        "unit": "CNY",
        "precision": 2
      }
    },
    {
      "id": "page_is",
      "required": true,
      "condition": {
        "operator": "page_is",
        "target": { "locator_ref": "page" },
        "source": "native"
      }
    },
    {
      "id": "semantic",
      "required": true,
      "condition": {
        "operator": "semantic",
        "timeout_ms": 10000,
        "target": { "locator_ref": "page" },
        "source": "vision",
        "expected": "The cart summary describes the declared product without an error banner."
      }
    }
  ]
}
