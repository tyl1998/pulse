{
  "$schema": "urn:pulse:schema:1-draft:case",
  "case_id": "all-pass",
  "name": "Every non-semantic operator has a positive sample",
  "goal": "Fixed expectations that match the observed cart are all passed",
  "parameters": {},
  "profile_refs": ["fake-android"],
  "inputs": {},
  "locators": {},
  "preconditions": [],
  "steps": [
    {
      "type": "wait",
      "id": "ready",
      "condition": { "operator": "exists", "target": { "locator_ref": "page" }, "source": "native" }
    }
  ],
  "checks": [
    {
      "id": "exists",
      "required": true,
      "condition": {
        "operator": "exists",
        "target": { "locator_ref": "price" },
        "source": "native"
      }
    },
    {
      "id": "not_exists",
      "required": true,
      "condition": {
        "operator": "not_exists",
        "target": { "locator_ref": "banner" },
        "source": "native",
        "scope": { "locator_ref": "page" },
        "observation_window_ms": 300,
        "poll_interval_ms": 100
      }
    },
    {
      "id": "visible",
      "required": true,
      "condition": {
        "operator": "visible",
        "target": { "locator_ref": "price" },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "enabled",
      "required": true,
      "condition": {
        "operator": "enabled",
        "target": { "locator_ref": "confirm" },
        "source": "native",
        "expected": true
      }
    },
    {
      "id": "checked",
      "required": true,
      "condition": {
        "operator": "checked",
        "target": { "locator_ref": "confirm" },
        "source": "native",
        "expected": false
      }
    },
    {
      "id": "text_equals",
      "required": true,
      "condition": {
        "operator": "text_equals",
        "target": { "locator_ref": "title" },
        "source": "native",
        "expected": "Total: ¥12.50"
      }
    },
    {
      "id": "contains",
      "required": true,
      "condition": {
        "operator": "contains",
        "target": { "locator_ref": "title" },
        "source": "native",
        "expected": "¥12.5"
      }
    },
    {
      "id": "regex",
      "required": true,
      "condition": {
        "operator": "regex",
        "target": { "locator_ref": "title" },
        "source": "native",
        "expected": "^Total: ¥\\d+\\.\\d{2}$"
      }
    },
    {
      "id": "count_eq",
      "required": true,
      "condition": {
        "operator": "count_eq",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": { "data_ref": "order", "key": "count" }
      }
    },
    {
      "id": "count_gt",
      "required": true,
      "condition": {
        "operator": "count_gt",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": 0
      }
    },
    {
      "id": "count_lt",
      "required": true,
      "condition": {
        "operator": "count_lt",
        "target": { "locator_ref": "items" },
        "source": "native",
        "expected": 2
      }
    },
    {
      "id": "number_cmp",
      "required": true,
      "condition": {
        "operator": "number_cmp",
        "target": { "locator_ref": "price" },
        "source": "native",
        "comparison": "eq",
        "expected": { "data_ref": "order", "key": "total" },
        "unit": "CNY",
        "precision": 2
      }
    },
    {
      "id": "page_is",
      "required": true,
      "condition": {
        "operator": "page_is",
        "target": { "locator_ref": "page" },
        "source": "native"
      }
    }
  ]
}
