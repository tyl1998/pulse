        "unique": true,
        "visible": true
      }
    },
    "discount": {
      "candidates": [
        {
          "by": "res_id",
          "value": "com.pulse.target:id/discount"
        }
      ],
      "expect": {
        "unique": true,
        "visible": true
      }
    },
    "dollars": {
      "candidates": [
        {
          "by": "res_id",
          "value": "com.pulse.target:id/dollars"
        }
      ],
      "expect": {
        "unique": true,
        "visible": true
      }
    }
