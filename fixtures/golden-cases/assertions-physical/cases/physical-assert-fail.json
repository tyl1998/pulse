{
  "$schema": "urn:pulse:schema:1-draft:case",
  "case_id": "physical-assert-fail",
  "name": "Physical assertion operators (negative)",
  "goal": "Every non-semantic operator is checked against the real FormActivity with a contradicting or unverifiable expectation",
  "parameters": {
    "name": {
      "type": "string",
      "required": false,
      "default": "Pulse"
    }
  },
  "profile_refs": ["target-form"],
  "inputs": {},
  "locators": {},
  "preconditions": [
    {
      "id": "form-visible",
      "required": true,
      "condition": {
        "operator": "exists",
        "target": {
          "locator_ref": "title"
        },
        "source": "native",
        "timeout_ms": 30000
      }
    }
  ],
  "steps": [
    {
      "type": "action",
      "id": "launch-form",
      "action": {
        "kind": "launch",
        "app_id": "com.pulse.target"
      },
      "timeout_ms": 120000
    },
    {
      "type": "flow",
      "id": "fill-flow",
      "flow_ref": "fill-name",
      "arguments": {
        "value": {
          "param_ref": "name"
        }
      },
      "bind": {
        "echo": "observed_name"
      },
      "timeout_ms": 180000
    },
    {
      "type": "action",
      "id": "use-return",
      "action": {
        "kind": "input",
        "target": {
          "locator_ref": "name"
        },
        "text": {
          "var_ref": "observed_name"
        },
        "mode": "replace"
      },
      "timeout_ms": 120000
    },
    {
      "type": "if",
      "id": "ensure-large",
      "condition": {
        "operator": "checked",
        "target": {
          "locator_ref": "large"
        },
        "source": "native",
        "expected": true,
        "timeout_ms": 30000
      },
      "then": [
        {
          "type": "wait",
          "id": "ensure-large-already",
          "condition": {
            "operator": "exists",
            "target": {
              "locator_ref": "title"
            },
            "source": "native",
            "timeout_ms": 30000
          },
          "timeout_ms": 60000
        }
      ],
      "else": [
        {
          "type": "action",
          "id": "tap-large",
          "action": {
            "kind": "tap",
            "target": {
              "locator_ref": "large"
            }
          },
          "timeout_ms": 120000
        }
      ],
      "timeout_ms": 180000
    },
    {
      "type": "if",
      "id": "ensure-agree",
      "condition": {
        "operator": "checked",
        "target": {
          "locator_ref": "agree"
        },
        "source": "native",
        "expected": true,
        "timeout_ms": 30000
      },
      "then": [
        {
          "type": "wait",
          "id": "ensure-agree-already",
          "condition": {
            "operator": "exists",
            "target": {
              "locator_ref": "title"
            },
            "source": "native",
            "timeout_ms": 30000
          },
          "timeout_ms": 60000
        }
      ],
      "else": [
        {
          "type": "action",
          "id": "tap-agree",
          "action": {
            "kind": "tap",
            "target": {
              "locator_ref": "agree"
            }
          },
          "timeout_ms": 120000
        }
      ],
      "timeout_ms": 180000
    },
    {
      "type": "wait",
      "id": "submit-enabled",
      "timeout_ms": 60000,
      "condition": {
        "operator": "enabled",
        "target": {
          "locator_ref": "submit"
        },
        "source": "native",
        "expected": true,
        "timeout_ms": 30000
      }
    },
    {
      "type": "action",
      "id": "tap-submit",
      "action": {
        "kind": "tap",
        "target": {
          "locator_ref": "submit"
        }
      },
      "timeout_ms": 120000
    },
    {
      "type": "wait",
      "id": "result-text",
      "timeout_ms": 60000,
      "condition": {
        "operator": "contains",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "expected": "提交成功",
        "timeout_ms": 30000
      }
    }
  ],
  "checks": [
    {
      "id": "exists",
      "required": false,
      "condition": {
        "operator": "exists",
        "target": {
          "locator_ref": "dialogs"
        },
        "source": "native",
        "timeout_ms": 30000
      }
    },
    {
      "id": "not_exists",
      "required": false,
      "condition": {
        "operator": "not_exists",
        "target": {
          "locator_ref": "title"
        },
        "source": "native",
        "scope": {
          "locator_ref": "title"
        },
        "observation_window_ms": 1000,
        "poll_interval_ms": 500,
        "timeout_ms": 30000
      }
    },
    {
      "id": "visible",
      "required": false,
      "condition": {
        "operator": "visible",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "expected": false,
        "timeout_ms": 30000
      }
    },
    {
      "id": "enabled",
      "required": true,
      "condition": {
        "operator": "enabled",
        "target": {
          "locator_ref": "submit"
        },
        "source": "native",
        "expected": false,
        "timeout_ms": 30000
      }
    },
    {
      "id": "checked",
      "required": true,
      "condition": {
        "operator": "checked",
        "target": {
          "locator_ref": "large"
        },
        "source": "native",
        "expected": true,
        "timeout_ms": 30000
      }
    },
    {
      "id": "text_equals",
      "required": true,
      "condition": {
        "operator": "text_equals",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "expected": "提交成功：PulseX / 大杯 / 通知关",
        "timeout_ms": 30000
      }
    },
    {
      "id": "contains",
      "required": true,
      "condition": {
        "operator": "contains",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "expected": "小杯",
        "timeout_ms": 30000
      }
    },
    {
      "id": "regex",
      "required": true,
      "condition": {
        "operator": "regex",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "expected": "^提交成功：$",
        "timeout_ms": 30000
      }
    },
    {
      "id": "count_eq",
      "required": true,
      "condition": {
        "operator": "count_eq",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": 1,
        "timeout_ms": 30000
      }
    },
    {
      "id": "count_gt",
      "required": true,
      "condition": {
        "operator": "count_gt",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": 0,
        "timeout_ms": 30000
      }
    },
    {
      "id": "count_lt",
      "required": true,
      "condition": {
        "operator": "count_lt",
        "target": {
          "locator_ref": "items"
        },
        "source": "native",
        "expected": 2,
        "timeout_ms": 30000
      }
    },
    {
      "id": "number_cmp",
      "required": false,
      "condition": {
        "operator": "number_cmp",
        "target": {
          "locator_ref": "result"
        },
        "source": "native",
        "comparison": "gte",
        "expected": 1,
        "unit": "杯",
        "precision": 0,
        "timeout_ms": 30000
      }
    },
    {
      "id": "page_is",
      "required": true,
      "condition": {
        "operator": "page_is",
        "target": {
          "locator_ref": "title"
        },
        "source": "native",
        "timeout_ms": 30000
      }
    },
    {
      "id": "graphic-empty",
      "required": false,
      "condition": {
        "operator": "number_cmp",
        "target": {
          "locator_ref": "result"
        },
        "source": "vision",
        "comparison": "gte",
        "expected": 1,
        "unit": "杯",
        "precision": 0,
        "timeout_ms": 30000
      }
    }
  ]
}
